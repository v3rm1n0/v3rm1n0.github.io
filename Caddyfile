v3rm1n.dev {
	root * /var/www/portfolio
	encode zstd gzip

	header {
		# 'unsafe-inline' in script-src is required by the pre-hydration theme
		# script in index.html, which sets the page background before React
		# boots so a dark-mode visitor never sees a white flash. To drop it,
		# replace that inline script with a hashed CSP entry and re-verify the
		# no-flash behaviour.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Asset filenames are content-hashed by Vite, so they can be cached forever.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Load-bearing. content.json is fetched at runtime, so a long cache lifetime
	# here would serve stale content for a year after an edit in the container.
	@content path /content.json
	header @content Cache-Control "no-cache"

	file_server
}
